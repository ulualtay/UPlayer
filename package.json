{
  "name": "uplayer",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "description": "A Spotify-style music player powered by YouTube",
  "author": "UPlayer",
  "main": "build/electron/main.cjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include server server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:electron": "node scripts/make-icon.mjs && node scripts/build-electron.mjs",
    "app": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "youtubei.js": "^18.2.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.uplayer.app",
    "productName": "UPlayer",
    "copyright": "UPlayer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "build/electron/**",
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": ".tools/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "UPlayer",
      "artifactName": "UPlayer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "UPlayer-${version}-portable.${ext}"
    }
  }
}
